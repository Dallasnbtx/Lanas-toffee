# Copy to .env (or set in your host's dashboard). Never commit real keys.
PORT=5055
BASE_URL=http://localhost:5055          # your public URL once deployed, e.g. https://sweetshop.onrender.com
ADMIN_PASSWORD=                         # long random string, e.g. python3 -c 'import secrets;print(secrets.token_urlsafe(24))'
STRIPE_SECRET_KEY=                      # sk_test_... first, then sk_live_...  (blank = DEMO mode)
STRIPE_WEBHOOK_SECRET=                  # whsec_... from Stripe CLI or Dashboard webhook
# Optional order alerts (see notify.py)
NOTIFY_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
